# MongoDB connection string
CONNECTION_URL=mongodb://localhost:27017/sepia
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=
# OAuth client ID from Google Cloud Console (optional, enables Google sign-in)
GOOGLE_CLIENT_ID=
# Comma-separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:3000,https://sepia.onrender.com
# Number of reverse proxies in front of the server (1 on Render)
TRUST_PROXY=1
PORT=5000
